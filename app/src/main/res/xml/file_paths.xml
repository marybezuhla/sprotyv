<?xml version="1.0" encoding="utf-8"?>
<!-- Only two cache folders: scan (a photo from the camera app, one at a time) and share (a document the
     owner chose to send; removed on the next return to the app or its start) -->
<paths>
    <cache-path name="scan" path="scan/" />
    <cache-path name="share" path="share/" />
</paths>
