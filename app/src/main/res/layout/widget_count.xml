<?xml version="1.0" encoding="utf-8"?>
<!-- A count of "My shields": a small shield with the number, "+1" under it, the name if the owner wants it.
     The numbers are the same in every language. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical">
    <FrameLayout android:layout_width="56dp" android:layout_height="72dp">
        <ImageView android:layout_width="56dp" android:layout_height="64dp" android:src="@drawable/w_shield" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_number" android:layout_width="56dp" android:layout_height="52dp" android:gravity="center"
            android:text="3" android:textColor="@color/w_khaki_ink" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_plus" android:layout_width="wrap_content" android:layout_height="26dp" android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/w_shape_plus" android:minWidth="44dp" android:gravity="center" android:paddingHorizontal="10dp"
            android:text="+1" android:textColor="@color/w_khaki_bg" android:textSize="13sp" android:textStyle="bold" />
    </FrameLayout>
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:background="@drawable/w_shape_khaki" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:gravity="center"
        android:textColor="@color/w_khaki_ink" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
